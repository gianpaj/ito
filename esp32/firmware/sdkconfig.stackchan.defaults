# M5Stack StackChan / CoreS3: use after sdkconfig.defaults.
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set
CONFIG_ITOFS_AUDIO_STACKCHAN=y
# CONFIG_ITOFS_AUDIO_PLAIN_I2S is not set
CONFIG_ITOFS_AUDIO_VOLUME=35
CONFIG_ITOFS_SPLIT_ROW=y
# CONFIG_ITOFS_SPLIT_AUTO is not set
# CONFIG_ITOFS_BOOT_DEMOS is not set
CONFIG_ITOFS_BOOT_TEXT=y
CONFIG_CODEC_AW88298_SUPPORT=y
# CONFIG_CODEC_ES8311_SUPPORT is not set
# CONFIG_CODEC_ES7210_SUPPORT is not set
# CONFIG_CODEC_ES7243_SUPPORT is not set
# CONFIG_CODEC_ES7243E_SUPPORT is not set
# CONFIG_CODEC_ES8156_SUPPORT is not set
# CONFIG_CODEC_ES8389_SUPPORT is not set
# CONFIG_CODEC_ES8374_SUPPORT is not set
# CONFIG_CODEC_ES8388_SUPPORT is not set
# CONFIG_CODEC_TAS5805M_SUPPORT is not set
